<?xml version="1.0" encoding="utf-8"?>
<!-- In-app app icon: the Flux mark on a rounded indigo tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#4A3FE0" android:endColor="#12B5A6" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:width="40dp"
        android:height="40dp"
        android:drawable="@drawable/ic_dfast_mark"
        android:gravity="center" />
</layer-list>
