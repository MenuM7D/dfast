<?xml version="1.0" encoding="utf-8"?>
<!-- In-app app icon: the Flux mark on a rounded indigo tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dfast_primary" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:width="34dp"
        android:height="34dp"
        android:drawable="@drawable/ic_dfast_mark"
        android:gravity="center" />
</layer-list>
