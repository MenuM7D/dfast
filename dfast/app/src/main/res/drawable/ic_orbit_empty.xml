<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="128dp" android:height="128dp" android:gravity="center">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#40FFFFFF" />
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
    <item android:width="92dp" android:height="92dp" android:gravity="center">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#4A3FE0" android:endColor="#12B5A6" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item android:width="46dp" android:height="46dp" android:gravity="center" android:drawable="@drawable/ic_dfast_mark" />
</layer-list>
