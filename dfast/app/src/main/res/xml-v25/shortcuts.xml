<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/sc_search"
        android:shortcutShortLabel="@string/o_tab_search"
        android:shortcutLongLabel="@string/o_tab_search"
        android:shortcutDisabledMessage="@string/o_tab_search">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="dfast.app"
            android:targetClass="dfast.app.MainActivity">
            <extra android:name="destination" android:value="Search" />
        </intent>
    </shortcut>
