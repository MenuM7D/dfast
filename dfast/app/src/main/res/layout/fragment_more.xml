<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="140dp"
        tools:ignore="MissingConstraints">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/more"
            android:textColor="?attr/orbitInk"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Brand hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dfast_header"
            android:visibility="gone"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="22dp">

            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/ic_app_icon"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="132dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_wordmark_h2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/dfast_hub_tagline"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/orbitInkSoft" />

        </LinearLayout>

        <TextView
            style="@style/Widget.DFast.GroupLabel"
            android:visibility="gone"
            android:layout_marginTop="24dp"
            android:layout_marginStart="4dp"
            android:text="@string/dfast_group_library" />

        <!-- GridLayout reflows when a destination already lives in the dock. -->
        <GridLayout
            android:id="@+id/library_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="1">

            <TextView
                android:id="@+id/settings"
                style="@style/Widget.DFast.Row"
                android:layout_width="match_parent"
                android:layout_margin="5dp"
                android:text="@string/settings"
                app:drawableStartCompat="@drawable/ti_settings"
                app:drawableEndCompat="@drawable/ti_chevron_right"
                app:drawableTint="?attr/orbitInk"
                android:background="@drawable/bg_dfast_tile" />

            <TextView
                android:id="@+id/observe_sources"
                style="@style/Widget.DFast.Row"
                android:layout_width="match_parent"
                android:layout_margin="5dp"
                android:text="@string/observe_sources"
                app:drawableStartCompat="@drawable/ti_radar_2"
                app:drawableEndCompat="@drawable/ti_chevron_right"
                app:drawableTint="?attr/orbitInk"
                android:background="@drawable/bg_dfast_tile" />

            <TextView
                android:id="@+id/downloads"
                style="@style/Widget.DFast.Row"
                android:layout_width="match_parent"
                android:layout_margin="5dp"
                android:text="@string/downloads"
                app:drawableStartCompat="@drawable/ti_download"
                app:drawableEndCompat="@drawable/ti_chevron_right"
                app:drawableTint="?attr/orbitInk"
                android:background="@drawable/bg_dfast_tile" />

            <TextView
                android:id="@+id/terminal"
                style="@style/Widget.DFast.Row"
                android:layout_width="match_parent"
                android:layout_margin="5dp"
                android:text="@string/terminal"
                app:drawableStartCompat="@drawable/ti_terminal_2"
                app:drawableEndCompat="@drawable/ti_chevron_right"
                app:drawableTint="?attr/orbitInk"
                android:background="@drawable/bg_dfast_tile" />

            <TextView
                android:id="@+id/command_templates"
                style="@style/Widget.DFast.Row"
                android:layout_width="match_parent"
                android:layout_margin="5dp"
                android:text="@string/command_templates"
                app:drawableStartCompat="@drawable/ti_code"
                app:drawableEndCompat="@drawable/ti_chevron_right"
                app:drawableTint="?attr/orbitInk"
                android:background="@drawable/bg_dfast_tile" />

            <TextView
                android:id="@+id/logs"
                style="@style/Widget.DFast.Row"
                android:layout_width="match_parent"
                android:layout_margin="5dp"
                android:text="@string/logs"
                app:drawableStartCompat="@drawable/ti_file_text"
                app:drawableEndCompat="@drawable/ti_chevron_right"
                app:drawableTint="?attr/orbitInk"
                android:background="@drawable/bg_dfast_tile" />

            <TextView
                android:id="@+id/cookies"
                style="@style/Widget.DFast.Row"
                android:layout_width="match_parent"
                android:layout_margin="5dp"
                android:text="@string/cookies"
                app:drawableStartCompat="@drawable/ti_cookie"
                app:drawableEndCompat="@drawable/ti_chevron_right"
                app:drawableTint="?attr/orbitInk"
                android:background="@drawable/bg_dfast_tile" />

            <TextView
                android:id="@+id/telegram_row"
                style="@style/Widget.DFast.Row"
                android:layout_width="match_parent"
                android:layout_margin="5dp"
                android:background="@drawable/bg_dfast_tile"
                android:text="Telegram"
                app:drawableStartCompat="@drawable/ti_brand_telegram"
                app:drawableEndCompat="@drawable/ti_chevron_right"
                app:drawableTint="?attr/orbitInk" />

            <TextView
                android:id="@+id/source_row"
                style="@style/Widget.DFast.Row"
                android:layout_width="match_parent"
                android:layout_margin="5dp"
                android:background="@drawable/bg_dfast_tile"
                android:text="@string/source_code"
                app:drawableStartCompat="@drawable/ti_brand_github"
                app:drawableEndCompat="@drawable/ti_chevron_right"
                app:drawableTint="?attr/orbitInk" />


        </GridLayout>

        <TextView
            style="@style/Widget.DFast.GroupLabel"
            android:layout_marginTop="24dp"
            android:layout_marginStart="4dp"
            android:text="@string/dfast_group_app" />

        <TextView
            android:id="@+id/terminate"
            style="@style/Widget.DFast.Row"
            android:layout_margin="5dp"
            android:background="@drawable/bg_dfast_tile"
            android:paddingHorizontal="16dp"
            android:text="@string/kill_app"
            android:textColor="?attr/colorError"
            app:drawableStartCompat="@drawable/ti_power"
            app:drawableTint="?attr/colorError" />

    </LinearLayout>
</ScrollView>
