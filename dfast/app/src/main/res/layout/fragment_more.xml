<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="140dp"
        tools:ignore="MissingConstraints">

        <!-- Brand hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dfast_header"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="22dp">

            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/ic_app_icon"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="132dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_dfast_wordmark" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/dfast_hub_tagline"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="#D9FFFFFF" />

        </LinearLayout>

        <TextView
            style="@style/Widget.DFast.GroupLabel"
            android:layout_marginTop="24dp"
            android:layout_marginStart="4dp"
            android:text="@string/dfast_group_library" />

        <!-- GridLayout reflows when a destination already lives in the dock. -->
        <GridLayout
            android:id="@+id/library_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="2">

            <TextView
                android:id="@+id/terminal"
                style="@style/Widget.DFast.Tile"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="@string/terminal"
                app:drawableTopCompat="@drawable/ic_terminal" />

            <TextView
                android:id="@+id/logs"
                style="@style/Widget.DFast.Tile"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="@string/logs"
                app:drawableTopCompat="@drawable/ic_baseline_file_open_24" />

            <TextView
                android:id="@+id/command_templates"
                style="@style/Widget.DFast.Tile"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="@string/command_templates"
                app:drawableTopCompat="@drawable/ic_baseline_keyboard_arrow_right_24" />

            <TextView
                android:id="@+id/downloads"
                style="@style/Widget.DFast.Tile"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="@string/downloads"
                app:drawableTopCompat="@drawable/ic_downloads" />

            <TextView
                android:id="@+id/download_queue"
                style="@style/Widget.DFast.Tile"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="@string/download_queue"
                app:drawableTopCompat="@drawable/baseline_downloading_24" />

            <TextView
                android:id="@+id/cookies"
                style="@style/Widget.DFast.Tile"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="@string/cookies"
                app:drawableTopCompat="@drawable/baseline_cookie_24" />

            <TextView
                android:id="@+id/observe_sources"
                style="@style/Widget.DFast.Tile"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="@string/observe_sources"
                app:drawableTopCompat="@drawable/baseline_calendar_month_24" />

            <TextView
                android:id="@+id/settings"
                style="@style/Widget.DFast.Tile"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:text="@string/settings"
                app:drawableTopCompat="@drawable/ic_settings" />

        </GridLayout>

        <TextView
            style="@style/Widget.DFast.GroupLabel"
            android:layout_marginTop="24dp"
            android:layout_marginStart="4dp"
            android:text="@string/dfast_group_app" />

        <TextView
            android:id="@+id/terminate"
            style="@style/Widget.DFast.Row"
            android:layout_margin="5dp"
            android:background="@drawable/bg_dfast_tile"
            android:paddingHorizontal="16dp"
            android:text="@string/kill_app"
            android:textColor="?attr/colorError"
            app:drawableStartCompat="@drawable/ic_power"
            app:drawableTint="?attr/colorError" />

    </LinearLayout>
</ScrollView>
