<?xml version="1.0" encoding="utf-8"?>
<!-- Quality card: title, chips that wrap (never cut), and a scale of the real levels. Same ids as format_item. -->
<com.google.android.material.card.MaterialCardView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/format_card_constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:checkedIcon="@null"
    app:cardBackgroundColor="?attr/orbitGlass"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/format_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:textDirection="locale"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/format_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:clickable="false"
                android:gravity="end"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="?attr/colorPrimaryInverse"
            android:textColor="?attr/orbitInk"
            android:clickable="false"
            android:gravity="center"
            android:minWidth="30dp"
            android:paddingHorizontal="5dp"
            android:textStyle="bold" />
        <TextView
                            android:id="@+id/audio_formats"
                            style="@style/Widget.Material3.FloatingActionButton.Large.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/rounded_corner"
                            android:backgroundTint="?attr/colorPrimary"
                            android:clickable="false"
                            android:gravity="center"
                            android:maxLength="17"
                            android:minWidth="30dp"
                            android:paddingHorizontal="5dp"
                            android:outlineProvider="none"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            app:drawableStartCompat="@drawable/ic_music_formatcard"  />
        <TextView
                            android:id="@+id/codec"
                            style="@style/Widget.Material3.FloatingActionButton.Large.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/rounded_corner"
                            android:backgroundTint="?attr/colorSecondary"
                            android:clickable="false"
                            android:gravity="center"
                            android:outlineProvider="none"
                            android:maxWidth="90dp"
                            android:minWidth="30dp"
                            android:paddingHorizontal="5dp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />
        <TextView
                            android:id="@+id/file_size"
                            style="@style/Widget.Material3.FloatingActionButton.Large.Tertiary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/rounded_corner"
                            android:backgroundTint="?attr/colorSecondary"
                            android:clickable="false"
                            android:gravity="center"
                            android:minWidth="30dp"
                            android:outlineProvider="none"
                            android:paddingHorizontal="5dp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />
        <TextView
                            android:id="@+id/bitrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/rounded_corner"
                            android:backgroundTint="?attr/colorPrimaryInverse"
                            android:textColor="?attr/orbitInk"
                            android:clickable="false"
                            android:gravity="center"
                            android:minWidth="30dp"
                            android:paddingHorizontal="5dp"
                            android:outlineProvider="none"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />

            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="container,audio_formats,codec,file_size,bitrate"
                app:flow_horizontalBias="0"
                app:flow_horizontalGap="5dp"
                app:flow_verticalGap="6dp"
                app:flow_wrapMode="chain"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <dfast.app.ui.downloadcard.QualityScaleView
            android:id="@+id/quality_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/format_loading_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
