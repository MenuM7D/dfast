<?xml version="1.0" encoding="utf-8"?>
<!--
    DFast "Flux" design system.

    Rules that keep Arabic intact:
      - no letterSpacing anywhere: tracking breaks cursive joining and inflates
        the measured width until short labels ellipsize;
      - hierarchy comes from weight and size, never from tracking;
      - containers use minHeight, never a fixed height that can clip a line;
      - labels are never constrained to a single ellipsized line.
-->
<resources>

    <!-- Type scale -->
    <style name="TextAppearance.DFast.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/plex_bold</item>
        <item name="fontFamily">@font/plex_bold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/plex_bold</item>
        <item name="fontFamily">@font/plex_bold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/plex_bold</item>
        <item name="fontFamily">@font/plex_bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:lineSpacingMultiplier">1.14</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="fontFamily">@font/plex_semibold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="fontFamily">@font/plex_semibold</item>
        <item name="android:textSize">23sp</item>
        <item name="android:lineSpacingMultiplier">1.22</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="fontFamily">@font/plex_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="fontFamily">@font/plex_semibold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="fontFamily">@font/plex_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="fontFamily">@font/plex_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/plex_regular</item>
        <item name="fontFamily">@font/plex_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plex_regular</item>
        <item name="fontFamily">@font/plex_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/plex_regular</item>
        <item name="fontFamily">@font/plex_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="fontFamily">@font/plex_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="fontFamily">@font/plex_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="fontFamily">@font/plex_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="fontFamily">@font/plex_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.DFast.NavLabelActive" parent="TextAppearance.DFast.NavLabel">
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="fontFamily">@font/plex_semibold</item>
    </style>

    <!-- Corner scale -->
    <style name="ShapeAppearance.DFast.Corner.ExtraSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.DFast.Corner.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.DFast.Corner.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.DFast.Corner.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="ShapeAppearance.DFast.Corner.ExtraLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.DFast.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.DFast.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Components -->
    <style name="Widget.DFast.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/dfast_glass</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="rippleColor">?attr/colorPrimary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.DFast.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">26dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAppearance">@style/TextAppearance.DFast.LabelLarge</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.DFast.ExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.DFast.Corner.Medium</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textAppearance">@style/TextAppearance.DFast.LabelLarge</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.DFast.NavIndicator" parent="">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="android:width">62dp</item>
        <item name="android:height">30dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DFast.Pill</item>
    </style>

    <style name="Widget.DFast.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@android:color/transparent</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.DFast.NavIndicator</item>
        <item name="itemIconTint">@color/dfast_nav_item</item>
        <item name="itemTextColor">@color/dfast_nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.DFast.NavLabelActive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.DFast.NavLabel</item>
        <!-- only the current destination shows a label: labels can never be squeezed -->
        <item name="labelVisibilityMode">selected</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.DFast.SearchBar" parent="Widget.Material3.SearchBar">
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="elevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DFast.Corner.Medium</item>
        <item name="android:minHeight">56dp</item>
        <item name="maxButtonHeight">56dp</item>
        <item name="android:textAppearance">@style/TextAppearance.DFast.BodyLarge</item>
    </style>

    <style name="Widget.DFast.AppBar" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="liftOnScroll">false</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.DFast.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.DFast.TitleLarge</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Hub tile: the whole tile is the touch target, the label wraps freely. -->
    <style name="Widget.DFast.Tile" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">104dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="fontFamily">@font/plex_medium</item>
        <item name="drawableTint">?attr/colorPrimary</item>
        <item name="android:background">@drawable/bg_dfast_tile</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.DFast.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="fontFamily">@font/plex_medium</item>
        <item name="drawableTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.DFast.GroupLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.DFast.TitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Widget.DFast.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">18dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <style name="Animation.DFast.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/dfast_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/dfast_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/dfast_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/dfast_fade_out</item>
    </style>

    <style name="Widget.DFast.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/dfast_glass</item>
        <item name="chipStrokeColor">#55FFFFFF</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="chipIconTint">#FFFFFF</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Material3.Chip</item>
        <item name="chipCornerRadius">20dp</item>
    </style>
    <style name="DFastQueuePill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_queue_pill</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:clickable">false</item>
    </style>

    <!-- DFast text fields: outlined, rounded, purple focus. Replaces the stock filled boxes. -->
    <style name="Widget.DFast.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
    <style name="Widget.DFast.TextInputLayout.Dense" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="Widget.DFast.TextInputLayout.ExposedDropdownMenu" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
</resources>
