<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:widgetLayout="@layout/preferece_material_switch"
        app:defaultValue="false"
        app:icon="@drawable/ti_settings"
        app:key="expert_mode"
        app:summary="@string/o_expert_mode_summary"
        app:title="@string/o_expert_mode" />

    <Preference
        android:key="appearance"
        app:icon="@drawable/ti_settings"
        android:title="@string/appearance"/>

    <Preference
        android:key="home_search"
        app:icon="@drawable/ti_home"
        android:title="@string/o_pg_home"/>

    <Preference
        android:key="folders"
        app:icon="@drawable/ti_folder"
        android:title="@string/o_pg_files"/>

    <Preference
        android:key="playback"
        app:icon="@drawable/ti_player_play"
        android:title="@string/o_pg_playback"/>

    <Preference
        android:key="downloading"
        app:icon="@drawable/ti_download"
        android:title="@string/downloads"/>

    <Preference
        android:key="processing"
        app:icon="@drawable/ti_file_text"
        android:title="@string/o_pg_formats"/>

    <Preference
        android:key="updating"
        app:icon="@drawable/ti_cloud_download"
        android:title="@string/updating"/>

    <Preference
        android:key="network_safety"
        app:icon="@drawable/ti_antenna_bars_5"
        android:title="@string/o_pg_data"/>

    <Preference
        android:key="advanced"
        app:icon="@drawable/ti_code"
        android:title="@string/o_pg_engine"/>

    <PreferenceCategory android:title="@string/o_g_yt">
        <Preference
            android:key="yt_account"
            app:icon="@drawable/ti_user_circle"
            android:title="@string/o_yt_account" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/backup_restore">
        <Preference
            app:icon="@drawable/ti_database_export"
            app:key="backup"
            app:title="@string/backup"/>

        <Preference
            app:icon="@drawable/ti_database_import"
            app:key="restore"
            app:title="@string/restore"/>

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/ti_clock"
            app:key="automatic_backup"
            android:summary="@string/automatic_backup_summary"
            app:title="@string/automatic_backup" />

        <Preference
            app:icon="@drawable/ti_folder"
            android:summary=""
            app:key="backup_path"
            app:title="@string/backup_path" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/about" >
        <Preference
            app:icon="@drawable/ti_info_circle"
            app:key="app_version"
            app:title="@string/version" />
        <Preference
            app:icon="@drawable/ti_package"
            app:key="package_name"
            app:title="@string/package_name" />
        <Preference
            app:icon="@drawable/ti_users"
            app:key="translators"
            app:summary="@string/translators_summary"
            app:title="@string/translators" />

        <Preference
            app:icon="@drawable/ti_shield_lock"
            app:key="security"
            app:title="@string/security">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/MenuM7D/dfast/blob/main/SECURITY.md" />
        </Preference>

        <Preference
            app:icon="@drawable/ti_license"
            app:key="license"
            app:summary="GNU General Public License v3.0"
            app:title="@string/license">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/MenuM7D/dfast/blob/main/LICENSE" />
        </Preference>


    </PreferenceCategory>


    <PreferenceCategory
        android:key="developer_category"
        app:isPreferenceVisible="false"
        android:title="@string/o_developer">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:key="developer_mode"
            app:summary="@string/o_developer_mode_summary"
            app:title="@string/o_developer_mode" />
    </PreferenceCategory>

</PreferenceScreen>