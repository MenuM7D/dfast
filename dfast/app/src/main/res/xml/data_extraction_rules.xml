<?xml version="1.0" encoding="utf-8"?>
<!-- The signed-in YouTube session and the cached feeds must never leave the device through backup or transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="google_cookies.txt"/>
        <exclude domain="file" path="feedcache"/>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="google_cookies.txt"/>
        <exclude domain="file" path="feedcache"/>
    </device-transfer>
</data-extraction-rules>
